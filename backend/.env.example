# Copy to .env and fill in. Never commit .env.

# --- app ---
APP_ENV=local                              # local | staging | production
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000   # comma-separated

# --- LLM (provider-agnostic; one swap changes vendor) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_S=30
GROQ_API_KEY=

# --- embeddings (open weights, local by default) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_S=30
OLLAMA_BASE_URL=http://localhost:11434

# --- database (Phase 2: Supabase Postgres + pgvector) ---
# Plain Postgres URL on purpose — no supabase-js, so the DB stays portable.
DATABASE_URL=
