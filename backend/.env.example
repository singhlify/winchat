# Copy to .env and fill in. Never commit .env.

# --- app ---
APP_ENV=local                              # local | staging | production
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000   # comma-separated allowlist, never "*"

# --- LLM (provider-agnostic; one swap changes vendor) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_S=30
LLM_RETRY_BUDGET_S=20                      # how long a request may wait out a rate limit
GROQ_API_KEY=

# --- embeddings ---
# Whatever embeds the corpus must embed the queries. Changing the model requires a
# re-ingest; the pipeline detects it, because vectors from two models are not comparable.
#
# `cohere` is the deployed default: hosted, so no model ships in the container (920 MB ->
# 392 MB image, which is the difference between a paid tier and a free one). It is NOT
# open-weight — see the README section that says so out loud.
#
# For an open-weight pipeline: `uv sync --extra local`, then set `fastembed` (in-process
# ONNX, no daemon) or `ollama` (needs `ollama pull nomic-embed-text`). Both need
# migration 0004 reversed to vector(768) first — the dimension is part of the schema.
EMBEDDING_PROVIDER=cohere        # cohere | fastembed | ollama | openai_compatible
EMBEDDING_MODEL=nomic-embed-text # only read by the ollama/openai_compatible providers
EMBEDDING_TIMEOUT_S=30
COHERE_EMBED_MODEL=embed-v4.0
COHERE_EMBED_DIMENSION=1024      # must match faq_chunks.embedding's declared width
# Seconds a rate-limited embed call may wait. Two budgets because a user waiting on a chat
# response gets seconds, while an offline ingest should sit out a whole window rather than
# abort several hundred answers in.
EMBEDDING_RETRY_BUDGET_S=20
EMBEDDING_INGEST_RETRY_BUDGET_S=300
OLLAMA_BASE_URL=http://localhost:11434
# Only for EMBEDDING_PROVIDER=openai_compatible.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- retrieval ---
RETRIEVAL_DENSE_K=50            # candidates from vector search
RETRIEVAL_LEXICAL_K=50          # candidates from keyword search
RETRIEVAL_RRF_K=60              # Reciprocal Rank Fusion constant (from the RRF paper)
RERANK_POOL=40                  # candidates sent to the reranker
RETRIEVAL_TOP_N=6               # passages that reach the model

# Refuse when nothing retrieved is close enough. Calibrated against THIS corpus with
# Cohere embed-v4.0 (on-topic 0.46-0.71, off-topic 0.15-0.29). The absolute value means
# nothing across models — nomic needed 0.66 for the same corpus. Changing the embedding
# model means re-running `python -m winchat_api.chat.calibrate`.
REFUSAL_MIN_DENSE_SCORE=0.38
REFUSAL_MIN_RERANK_SCORE=       # blank = disabled until it can be calibrated with a key

# Reranking is optional — without a key the app falls back to fused order and says so.
RERANK_PROVIDER=cohere          # or "none"
RERANK_MODEL=rerank-v3.5
RERANK_TIMEOUT_S=15
COHERE_API_KEY=

# --- auth & abuse control ---
# Auth is optional: the FAQ is public. Signing in buys history and a higher limit.
SUPABASE_URL=                   # https://<ref>.supabase.co — used to fetch the JWKS
SUPABASE_JWT_SECRET=            # only for legacy HS256 projects
REQUIRE_AUTH=false

RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_PER_DAY=60
RATE_LIMIT_GLOBAL_PER_DAY=2000  # the actual spend ceiling (OWASP LLM10)
RATE_LIMIT_SALT=change-me       # salts the hash of anonymous client addresses
TRUST_PROXY_HEADERS=false       # true ONLY behind a proxy you control (Render, Vercel)

# Optional. Lets you smoke-test a DEPLOYED instance without burning a real visitor's quota:
#   curl -H "X-Maintenance-Token: $TOKEN" ...
# It waives the per-subject rate limits and NOTHING else — no data access, no RLS bypass,
# and it still cannot exceed RATE_LIMIT_GLOBAL_PER_DAY. Blank disables the header entirely.
# Deliberately not an admin account: one credential that can do everything is the shape of
# every breach post-mortem. Generate with: openssl rand -hex 24
MAINTENANCE_TOKEN=       # true ONLY behind a proxy you control (Render, Vercel)

# --- evaluation ---
EVAL_MODEL=llama-3.3-70b-versatile      # the pinned reference model for quality claims
EVAL_JUDGE_MODEL=openai/gpt-oss-120b    # a different family: models prefer their own output
EVAL_CONCURRENCY=2
EVAL_RETRY_BUDGET_S=900                 # offline work can wait out a per-minute budget
EVAL_MIN_RETRIEVAL_RECALL=0.85
EVAL_MIN_DETERMINISTIC_PASS=0.85
EVAL_MIN_FAITHFULNESS=0.90
EVAL_MIN_CORRECTNESS=0.85

# --- database (Supabase Postgres + pgvector) ---
# Plain Postgres URL on purpose — no supabase-js, so the DB stays portable.
# Use the SESSION POOLER connection string: the direct connection is IPv6-only on the free
# tier. Percent-encode special characters in the password (? and # break URL parsing).
DATABASE_URL=
