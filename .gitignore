# Secrets / config
.env
.env.*
!.env.example

# Scraped corpus — regenerable via scripts/scrape_ask_uwindsor.py, large, drifts from source
data/ask_uwindsor/
data/**/raw/
# Ignore data by path, never by extension. A blanket `*.jsonl` here silently excluded the
# golden eval set, so the code shipped and the data it is measured against did not.

# Python (uv)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Next.js
node_modules/
.next/
out/
dist/
.turbo/

# Vector store artifacts (if any local)
chroma/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/


# Local development context — not part of the shipped project.
# No trailing slash on `docs`: it is a symlink to the private notes repo, and `docs/` matches
# only real directories, so the slash would leave the link itself tracked.
docs
CONTRIBUTING.md
scripts/azure_free_tier_audit.sh
