# Copy to .env.local. NEXT_PUBLIC_* is inlined into the browser bundle —
# never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The site's own public origin. Not decoration: `metadataBase` uses it to make canonical
# and Open Graph URLs absolute, so leaving it unset ships blank link previews. Must be the
# real deployed origin in production, e.g. https://winchat.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth is optional — leave these blank and the app runs anonymously.
# supabase-js is used ONLY for login; all data access goes through our API as plain SQL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile SITE key (public by design -- it is rendered into the page).
# Blank disables the challenge. Pairs with TURNSTILE_SECRET_KEY on the backend; setting one
# without the other means either no verification or no token, so set both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
